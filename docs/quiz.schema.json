{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quiz.json — LMS Langues",
  "type": "object",
  "required": ["questions"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "title": { "type": "string" },
    "passingScore": { "type": "number", "minimum": 0, "maximum": 100, "description": "Note minimale (%) ; défaut = manifest.json puis réglage global (80)" },
    "timeLimitSec": { "type": "integer", "minimum": 30, "description": "Durée max ; soumission automatique à 0" },
    "shuffleQuestions": { "type": "boolean" },
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "type", "text"],
        "properties": {
          "id": { "type": "string", "description": "Unique dans le fichier" },
          "type": { "enum": ["mcq", "true_false", "fill_blank"] },
          "text": { "type": "string" },
          "points": { "type": "number", "default": 1 },
          "explanation": { "type": "string", "description": "Affichée après correction" },
          "options": { "type": "array", "items": { "type": "string" }, "minItems": 2, "description": "mcq" },
          "answer": { "description": "mcq : tableau d'indices (0 = 1re option) ; true_false : booléen" },
          "answers": { "type": "array", "items": { "type": "string" }, "description": "fill_blank : réponses acceptées" },
          "caseSensitive": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
